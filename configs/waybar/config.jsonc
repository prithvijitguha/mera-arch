{
  "layer": "top",
  "position": "top",
  "exclusive": true,
  "modules-left": [
    "ext/workspaces"
  ],
  "modules-center": [
    "mango/window"
  ],
  "modules-right": [
    "network",
    "pulseaudio",
    "battery",
    "memory",
    "custom/power"
  ],
  "reload_style_on_change": true,
  // ============================================================
  // MangoWC window
  // ============================================================
  "mango/window": {
    "format": "{}",
    "icon": false,
    "max-length": 50,
    "tooltip": false
  },
  // ============================================================
  // MangoWC workspaces / tags
  //
  // 1 = Programming
  // 2 = Browser
  // 3 = Gaming
  // 4 = Media
  // 5 = Communication
  // 6 = Misc
  // ============================================================
  "ext/workspaces": {
    "format": "{icon}",
    "hide-empty": false,
    "ignore-hidden": false,
    "sort-by-id": true,
    "on-click": "activate",
    "on-click-right": "deactivate",
    "format-icons": {
      "1": "Programming",
      "2": "Browser",
      "3": "Gaming",
      "4": "Media",
      "5": "Communication",
      "6": "Misc"
    }
  },
  // ============================================================
  // System tray
  // ============================================================
  "tray": {
    "format": "{icon}",
    "tooltip": true,
    "icon-size": 18,
    "spacing": 0
  },
  // Network 
  "network": {
    "format-wifi": "{icon}",
    "format-ethernet": "",
    "format-linked": "󱘖",
    "format-disconnected": "󰤣",
    "format-disabled": "󰤮",
    "format-icons": [
      "󰤯",
      "󰤟",
      "󰤢",
      "󰤥",
      "󰤨"
    ],
    "on-click": "iwgtk"
  },
  // ============================================================
  // Audio
  // ============================================================
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟",
    "tooltip": true,
    "format-icons": {
      "headphone": "",
      "speaker": "",
      "default": [
        "",
        "",
        ""
      ]
    },
    "scroll-step": 5,
    "on-click": "pavucontrol"
  }, // ============================================================
  // Battery
  // ============================================================
  "battery": {
    "interval": 60,
    "states": {
      "warning": 15,
      "critical": 5
    },
    "events": {
      "on-discharging-warning": "notify-send -u normal 'Low Battery'",
      "on-discharging-critical": "notify-send -u critical 'Very Low Battery'",
      "on-charging-100": "notify-send -u normal 'Battery Full!'",
      "on-discharging": "notify-send -u normal 'Power Switch' 'Discharging'",
      "on-charging": "notify-send -u normal 'Power Switch' 'Charging'"
    },
    "format": "{icon} {capacity}%",
    "format-icons": [
      "󰁺",
      "󰁻",
      "󰁼",
      "󰁽",
      "󰁾",
      "󰁿",
      "󰂀",
      "󰂁",
      "󰂂",
      "󰁹"
    ],
    "max-length": 25
  },
  // ============================================================
  // Memory
  // ============================================================
  "memory": {
    "format": "{used:0.1f}G/{total:0.1f}G",
    "interval": 4
  },
  // ============================================================
  // Clock
  // ============================================================
  "custom/power": {
    "format": "⏻",
    "tooltip": true,
    "tooltip-format": "Power",
    "menu": "on-click",
    "menu-file": "~/.config/waybar/power_menu.xml",
    "menu-actions": {
      "shutdown": "systemctl poweroff",
      "reboot": "systemctl reboot",
      "suspend": "systemctl suspend",
      "logout": "loginctl terminate-user $USER"
    }
  }
}
