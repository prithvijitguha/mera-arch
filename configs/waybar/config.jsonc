{
  "layer": "top",
  "position": "top",
  "exclusive": true,
  "modules-left": [
    "ext/workspaces"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "network",
    "pulseaudio",
    "cpu",
    "memory",
    "battery",
    "custom/power"
  ],
  "reload_style_on_change": true,
  "clock": {
    "format": " {:%I:%M %p  %a  %d %b %Y} ",
    "tooltip-format": "{:%Y}",
    "calendar": {
      "mode": "year",
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "on-scroll": 1,
      "format": {
        "months": "<span color='#ffead3'><b>{}</b></span>",
        "days": "<span color='#ecc6d9'><b>{}</b></span>",
        "weeks": "<span color='#99ffdd'><b>W{}</b></span>",
        "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
        "today": "<span color='#ff6699'><b><u>{}</u></b></span>"
      }
    },
    "on-click": "gnome-calendar",
  },
  "ext/workspaces": {
    "format": "{icon}",
    "hide-empty": false,
    "ignore-hidden": false,
    "sort-by-id": true,
    "on-click": "activate",
    "on-click-right": "deactivate",
    "format-icons": {
      "1": "Programming",
      "2": "Browser",
      "3": "Gaming",
      "4": "Media",
      "5": "Communication",
      "6": "Misc"
    }
  },
  // Network 
  "network": {
    "format-wifi": "{icon}",
    "format-ethernet": "",
    "format-linked": "󱘖",
    "format-disconnected": "󰤣",
    "format-disabled": "󰤮",
    "format-icons": [
      "󰤯",
      "󰤟",
      "󰤢",
      "󰤥",
      "󰤨"
    ],
    "on-click": "iwgtk"
  },
  // ============================================================
  // Audio
  // ============================================================
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟",
    "tooltip": true,
    "format-icons": {
      "headphone": "",
      "speaker": "",
      "default": [
        "",
        "",
        ""
      ]
    },
    "scroll-step": 5,
    "on-click": "pavucontrol"
  },
  "cpu": {
    "interval": 2,
    "format": " {load}%"
  },
  // ============================================================
  // Battery
  // ============================================================
  "battery": {
    "interval": 60,
    "states": {
      "warning": 15,
      "critical": 5
    },
    "events": {
      "on-discharging-warning": "notify-send -u normal 'Low Battery'",
      "on-discharging-critical": "notify-send -u critical 'Very Low Battery'",
      "on-charging-100": "notify-send -u normal 'Battery Full!'",
      "on-discharging": "notify-send -u normal 'Power Switch' 'Discharging'",
      "on-charging": "notify-send -u normal 'Power Switch' 'Charging'"
    },
    "format": "{icon} {capacity}%",
    "format-icons": [
      "󰁺",
      "󰁻",
      "󰁼",
      "󰁽",
      "󰁾",
      "󰁿",
      "󰂀",
      "󰂁",
      "󰂂",
      "󰁹"
    ],
    "max-length": 25
  },
  // ============================================================
  // Memory
  // ============================================================
  "memory": {
    "format": "󰍛 {used:0.1f}G/{total:0.1f}G",
    "interval": 4
  },
  // ============================================================
  // Power
  // ============================================================
  "custom/power": {
    "format": "⏻",
    "tooltip": true,
    "tooltip-format": "Power",
    "menu": "on-click",
    "menu-file": "~/.config/waybar/power_menu.xml",
    "menu-actions": {
      "shutdown": "systemctl poweroff",
      "reboot": "systemctl reboot",
      "suspend": "systemctl suspend",
      "logout": "loginctl terminate-user $USER"
    }
  }
}
