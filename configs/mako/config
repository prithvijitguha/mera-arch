# General appearance
sort=-time
layer=overlay
anchor=top-right
width=400
height=600
margin=12
padding=14
border-size=2
border-radius=10
icons=1
max-icon-size=48
font=JetBrains Mono 11
background-color=#2E3440F2
text-color=#ECEFF4
border-color=#81A1C1

# Notification behavior
ignore-timeout=0
group-by=app-name
format=<b>%s</b>\n%b
markup=1
default-timeout=5000

[urgency=low]
border-color=#616E88
text-color=#D8DEE9

[urgency=normal]
border-color=#88C0D0

[urgency=high]
border-color=#BF616A
background-color=#3B3038
text-color=#ECEFF4

[category=mpd]
group-by=category
