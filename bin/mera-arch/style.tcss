Screen {
    align: center middle;
}

#main {
    width: 80%;
    max-width: 100;
    height: auto;
    max-height: 90%;
    border: round #39c5ff;
    padding: 1 2;
    background: #0b1020;
}

#banner {
    color: #51d6ff;
    text-align: center;
    text-style: bold;
    height: auto;
    margin-bottom: 1;
}

#heading {
    color: #5b9dff;
    text-align: center;
    text-style: bold;
    margin-bottom: 1;
}

#options {
    height: 12;
    border: round #397bff;
}

#options > ListItem.--highlight {
    background: #174a83;
    color: #ffffff;
    text-style: bold;
}

#status {
    height: auto;
    margin-top: 1;
    color: #7daeff;
}
